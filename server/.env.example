# ------------------------------------------------------------------
# JARVIS Backend - Konfiguration
# Kopiere diese Datei nach server/.env und trage deine Werte ein.
# server/.env ist per .gitignore ausgeschlossen und landet nie auf GitHub.
# ------------------------------------------------------------------

# --- Grundlagen -----------------------------------------------------
PORT=8787
# Oeffentliche Adresse des Backends. MUSS stimmen, sonst schlagen die
# OAuth-Rueckleitungen fehl. Lokal: http://localhost:8787
PUBLIC_URL=https://mein-jarvis.onrender.com
# Frei gewaehltes Passwort. Genau dieses traegst du im iPad unter
# Einstellungen -> Zugriffsschluessel ein. Ohne das kaeme jeder an deine Mails.
JARVIS_TOKEN=bitte-hier-etwas-langes-und-zufaelliges
# Woher darf das Frontend kommen? Deine GitHub-Pages-Adresse.
ALLOWED_ORIGINS=https://michaelflitsch-spec.github.io

# --- Persoenliches --------------------------------------------------
OWNER_NAME=Michael
TIMEZONE=Europe/Vienna
LOCALE=de-DE
HOME_CITY=Wien
# Alternativ exakte Koordinaten (dann ist keine Ortssuche noetig):
# HOME_LAT=48.2082
# HOME_LON=16.3738

# --- Claude (das Gehirn) --------------------------------------------
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max - hoeher = gruendlicher, aber teurer/langsamer
ANTHROPIC_EFFORT=medium

# --- Google (Gmail + Kalender) --------------------------------------
# console.cloud.google.com -> APIs & Dienste -> OAuth-Client (Typ: Webanwendung)
# Autorisierte Weiterleitungs-URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# --- Spotify --------------------------------------------------------
# developer.spotify.com/dashboard -> App anlegen
# Redirect URI: <PUBLIC_URL>/auth/spotify/callback
# Achtung: Die Fernsteuerung der Wiedergabe setzt Spotify Premium voraus.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_BOOT_TRACK=track:"Back In Black" artist:"AC/DC"
SPOTIFY_BOOT_VOLUME=70
SPOTIFY_DUCK_VOLUME=22

# --- Notion ---------------------------------------------------------
# notion.so/my-integrations -> interne Integration anlegen, Token kopieren,
# dann die Datenbank/Seite fuer die Integration freigeben (... -> Verbindungen).
NOTION_TOKEN=
# ID der Aufgaben-Datenbank (aus der URL, 32 Zeichen)
NOTION_TASKS_DB=
# Seite oder Datenbank, unter der die Tages-/Wochenplaene entstehen
NOTION_PLAN_PARENT=

# --- Anruf aufs iPhone (Twilio) -------------------------------------
# console.twilio.com - Nummer kaufen, dann hier eintragen.
# Kostet pro Anruf ein paar Cent. Im Test-Modus muss deine Nummer verifiziert sein.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+43...
TWILIO_TO=+43...
TWILIO_VOICE=Google.de-DE-Standard-B
TWILIO_LANGUAGE=de-DE

# --- Push als Alternative zum Anruf ---------------------------------
# Beliebiger Webhook, der {title, message, priority} als JSON annimmt.
# Funktioniert z. B. mit ntfy.sh oder einer iOS-Kurzbefehl-Automation.
PUSH_WEBHOOK_URL=

# --- Automatischer Mail-Waechter ------------------------------------
# Prueft im Hintergrund neue Mails und ruft bei Dringlichkeit an.
MAIL_WATCH_ENABLED=false
MAIL_WATCH_INTERVAL=10
# Ab welcher Wichtigkeit (1-5) wird angerufen. 5 = nur wirklich dringend.
MAIL_CALL_THRESHOLD=5
# In dieser Zeit wird nicht angerufen.
MAIL_QUIET_HOURS=22:00-07:00
