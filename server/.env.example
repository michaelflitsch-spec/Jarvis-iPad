# JARVIS Backend Configuration
# Kopiere diese Datei nach .env und trage deine Werte ein

# --- Grundlagen ---
PORT=3000
PUBLIC_URL=http://localhost:3000
JARVIS_TOKEN=dein-sicheres-passwort-hier
OWNER_NAME=Michael
TIMEZONE=Europe/Vienna
ALLOWED_ORIGINS=http://localhost:8000,https://michaelflitsch-spec.github.io

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- ElevenLabs TTS ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Google OAuth ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Spotify OAuth ---
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# --- Notion ---
NOTION_API_KEY=...
NOTION_DATABASE_ID=...

# --- Optional: Weather API ---
OPENMETEO_API_ENABLED=true
